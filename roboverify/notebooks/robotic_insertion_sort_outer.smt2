(declare-sort RoboticSortBlock 0)
(declare-fun Before (RoboticSortBlock RoboticSortBlock) Bool)
(declare-fun InRow (RoboticSortBlock) Bool)
(declare-fun KeyLE (RoboticSortBlock RoboticSortBlock) Bool)
(declare-fun InBuffer (RoboticSortBlock) Bool)
(declare-fun AtAssignedSlot (RoboticSortBlock) Bool)
(declare-fun Processed (RoboticSortBlock) Bool)
(assert (forall ((axiom_x RoboticSortBlock)) (not (Before axiom_x axiom_x))))
(assert (forall ((axiom_x RoboticSortBlock)
         (axiom_y RoboticSortBlock)
         (axiom_z RoboticSortBlock))
  (=> (and (Before axiom_x axiom_y) (Before axiom_y axiom_z))
      (Before axiom_x axiom_z))))
(assert (forall ((axiom_x RoboticSortBlock) (axiom_y RoboticSortBlock))
  (=> (Before axiom_x axiom_y) (and (InRow axiom_x) (InRow axiom_y)))))
(assert (forall ((axiom_x RoboticSortBlock) (axiom_y RoboticSortBlock))
  (=> (and (InRow axiom_x) (InRow axiom_y))
      (or (= axiom_x axiom_y) (Before axiom_x axiom_y) (Before axiom_y axiom_x)))))
(assert (forall ((axiom_x RoboticSortBlock)) (KeyLE axiom_x axiom_x)))
(assert (forall ((axiom_x RoboticSortBlock) (axiom_y RoboticSortBlock))
  (or (KeyLE axiom_x axiom_y) (KeyLE axiom_y axiom_x))))
(assert (forall ((axiom_x RoboticSortBlock)
         (axiom_y RoboticSortBlock)
         (axiom_z RoboticSortBlock))
  (=> (and (KeyLE axiom_x axiom_y) (KeyLE axiom_y axiom_z))
      (KeyLE axiom_x axiom_z))))
(assert (forall ((axiom_x RoboticSortBlock))
  (not (and (InRow axiom_x) (InBuffer axiom_x)))))
(assert (forall ((axiom_x RoboticSortBlock))
  (=> (AtAssignedSlot axiom_x) (InRow axiom_x))))
(assert (let ((a!1 (forall ((ux1 RoboticSortBlock) (ux2 RoboticSortBlock))
             (or (not (Processed ux2)) (Before ux2 ux1) (Processed ux1))))
      (a!2 (forall ((ux1 RoboticSortBlock) (ux2 RoboticSortBlock))
             (or (not (Processed ux1)) (Before ux1 ux2) (KeyLE ux2 ux1))))
      (a!3 (forall ((ux1 RoboticSortBlock)) (InRow ux1))))
  (and a!1
       a!2
       (forall ((ux1 RoboticSortBlock) (ux2 RoboticSortBlock))
         (or (Before ux1 ux2) (Before ux2 ux1) (= ux1 ux2)))
       a!3
       a!3
       (forall ((ux1 RoboticSortBlock)) (AtAssignedSlot ux1)))))

(check-sat)
